{
  "name": "nhom1_kientrucvathietkephanmem_dhktpm18a",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "src/utils/validation.js",
      "src/utils/fetchWithRetry.js",
      "src/utils/rateLimitUtils.js",
      "src/stores/cartSlice.js",
      "src/stores/productSlice.js",
      "src/stores/userAdminSlice.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "moduleNameMapper": {
      "\\.(css|scss|sass|less)$": "<rootDir>/__mocks__/styleMock.js",
      "\\.(png|jpg|jpeg|gif|svg|webp)$": "<rootDir>/__mocks__/fileMock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "dependencies": {
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@react-oauth/google": "^0.13.5",
    "@reduxjs/toolkit": "^2.6.1",
    "@tailwindcss/vite": "^4.0.9",
    "antd": "^5.24.4",
    "axios": "^1.8.2",
    "connect-redis": "^9.0.0",
    "express-session": "^1.19.0",
    "framer-motion": "^12.9.2",
    "gsap": "^3.12.7",
    "lucide-react": "^0.483.0",
    "react": "^19.0.0",
    "react-apexcharts": "^1.7.0",
    "react-chatbot-kit": "^2.2.2",
    "react-dom": "^19.0.0",
    "react-fast-marquee": "^1.6.5",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.2.0",
    "react-slick": "^0.30.3",
    "react-spinners": "^0.15.0",
    "react-toastify": "^11.0.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "sass": "^1.85.1",
    "slick-carousel": "^1.8.1",
    "slugify": "^1.6.8",
    "sweetalert2": "^11.17.2",
    "swiper": "^12.2.0",
    "tailwindcss": "^4.0.9"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^9.19.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-jest": "^30.4.1",
    "concurrently": "^8.2.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "nodemon": "^3.0.1",
    "vite": "^6.1.0"
  }
}
